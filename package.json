{
    "name": "sgspe-ui",
    "version": "3.3.0",
    "private": true,
    "description": "SGSPE: portal y administración sobre @wasichai/*",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "lint": "prettier --check src e2e index.html package.json tsconfig.json tsconfig.build.json vite.config.ts playwright.config.ts csp.ts commitlint.config.mjs .github",
        "format": "prettier --write src e2e index.html package.json tsconfig.json tsconfig.build.json vite.config.ts playwright.config.ts csp.ts commitlint.config.mjs .github",
        "csp": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; import { contentSecurityPolicy } from './csp.ts'; console.log(contentSecurityPolicy(readFileSync('index.html', 'utf8'), process.env.SGSPE_MAPA_BASE ?? ''))\"",
        "test": "vitest run",
        "e2e": "playwright test --project=chromium",
        "capturas": "playwright test --project=capturas",
        "build": "tsc -p tsconfig.build.json && vite build",
        "typecheck": "tsc -p tsconfig.json",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@fontsource/public-sans": "5.3.0",
        "@hookform/resolvers": "7.0.8",
        "@remotion/player": "4.0.545",
        "@tanstack/react-query": "5.108.2",
        "@tiptap/core": "3.35.0",
        "@tiptap/markdown": "3.35.0",
        "@tiptap/pm": "3.35.0",
        "@tiptap/react": "3.35.0",
        "@tiptap/starter-kit": "3.35.0",
        "@wasichai/automation": "1.8.2",
        "@wasichai/core": "1.8.2",
        "@wasichai/documents": "1.8.2",
        "@wasichai/forms": "1.8.2",
        "@wasichai/gis": "1.8.2",
        "@wasichai/pages": "1.8.2",
        "@wasichai/sgspe-slides": "3.3.0",
        "@wasichai/ui": "1.8.2",
        "@wasichai/views": "1.8.2",
        "@wasichai/workflow": "1.8.2",
        "echarts": "6.1.0",
        "i18next": "27.2.3",
        "lucide-react": "1.77.0",
        "maplibre-gl": "6.19.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "7.92.0",
        "react-i18next": "18.0.3",
        "react-router": "8.5.2",
        "remotion": "4.0.545",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@playwright/test": "1.65.1",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "8.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "@wasichai/testing": "1.8.2",
        "fontnik": "0.7.7",
        "husky": "9.1.7",
        "jsdom": "31.0.1",
        "prettier": "3.10.1",
        "tailwindcss": "4.3.5",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
